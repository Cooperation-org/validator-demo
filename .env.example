# LinkedTrust backend (trust_claim_backend). dev.linkedtrust.us = dev instance (DB dev_linkedtrust); live.linkedtrust.us = production
LINKEDTRUST_API_URL=https://dev.linkedtrust.us
# This app's OIDC client on that backend (trust_claim_backend scripts/register-oidc-client.ts)
LINKEDTRUST_CLIENT_ID=
LINKEDTRUST_CLIENT_SECRET=

# SMTP, e.g. Amazon SES SMTP endpoint (email-smtp.<region>.amazonaws.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Verified SES sender address
SES_FROM_EMAIL=
