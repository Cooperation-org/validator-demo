# Public URL of this app, used for links in emails
APP_URL=http://localhost:8080

# Where this app keeps its JSON files (pending links; claims and invites in mock mode)
DATA_DIR=./data

# LinkedTrust: "api" uses LINKEDTRUST_API_URL; "mock" keeps the records in DATA_DIR
# Claims (dev.linkedtrust.us accepts them without client credentials)
LINKEDTRUST_CLAIMS=mock
# Testimonial requests (dev.linkedtrust.us does not have them yet)
LINKEDTRUST_INVITES=mock
# trust_claim_backend. dev.linkedtrust.us = dev instance (DB dev_linkedtrust); live.linkedtrust.us = production
LINKEDTRUST_API_URL=https://dev.linkedtrust.us
# This app's OIDC client on that backend (trust_claim_backend scripts/register-oidc-client.ts).
# Required for LINKEDTRUST_INVITES=api; optional for claims (sets the claim's issuer)
LINKEDTRUST_CLIENT_ID=
LINKEDTRUST_CLIENT_SECRET=

# "smtp" sends; "log" prints emails to the server log instead
EMAIL_MODE=smtp
# Amazon WorkMail: smtp.mail.<region>.awsapps.com, port 465, mailbox address and password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender address; with WorkMail, the same mailbox as SMTP_USER
SES_FROM_EMAIL=
